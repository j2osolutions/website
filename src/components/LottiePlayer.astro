---
interface Props {
  src: string;
  title: string;
  className?: string;
  loop?: boolean;
  autoplay?: boolean;
}

const { src, title, className = '', loop = true, autoplay = true } = Astro.props;
---

<div
  class:list={['lottie-shell', className]}
  aria-hidden="true"
  data-lottie-src={src}
  data-lottie-loop={loop ? 'true' : 'false'}
  data-lottie-autoplay={autoplay ? 'true' : 'false'}
>
  <div class="lottie-canvas"></div>
  <span class="sr-only">{title}</span>
</div>

<script>
  import lottie from 'lottie-web';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    const elements = document.querySelectorAll('[data-lottie-src]:not([data-lottie-ready])');

    for (const element of elements) {
      if (!(element instanceof HTMLElement)) continue;

      const container = element.querySelector('.lottie-canvas');
      const src = element.dataset.lottieSrc;

      if (!(container instanceof HTMLElement) || !src) continue;

      element.dataset.lottieReady = 'true';

      const shouldAutoplay = element.dataset.lottieAutoplay !== 'false';

      const instance = lottie.loadAnimation({
        container,
        renderer: 'svg',
        loop: element.dataset.lottieLoop !== 'false',
        autoplay: shouldAutoplay,
        path: src,
        rendererSettings: {
          progressiveLoad: true,
          preserveAspectRatio: 'xMidYMid meet',
        },
      });

      if (!shouldAutoplay) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                instance.play();
              } else {
                instance.pause();
              }
            }
          },
          { threshold: 0.2 },
        );

        observer.observe(element);
      }
    }
  }
</script>
