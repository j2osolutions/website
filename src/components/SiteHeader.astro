---
import type { Locale, SiteContent } from '../lib/content';

interface Props {
  locale: Locale;
  nav: SiteContent['nav'];
}

const { locale, nav } = Astro.props;
const isCargoPage = Astro.url.pathname.includes('/air-cargo');
const languageHref = locale === 'es'
  ? isCargoPage
    ? `${import.meta.env.BASE_URL}en/air-cargo/`
    : `${import.meta.env.BASE_URL}en/`
  : isCargoPage
    ? `${import.meta.env.BASE_URL}air-cargo/`
    : import.meta.env.BASE_URL;
const languageLabel = locale === 'es' ? 'EN' : 'ES';
const languageFlag = locale === 'es' ? '🇺🇸' : '🇪🇸';
const homeHref = locale === 'es' ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}en/`;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={homeHref} aria-label="J2O Solutions">
      <img src={`${import.meta.env.BASE_URL}J2O.png`} alt="J2O Solutions" width="96" height="96" />
      <span class="brand-copy">
      </span>
    </a>

    <details class="mobile-menu">
      <summary class="mobile-menu-toggle" aria-label={nav.ariaLabel}>
        <span class="mobile-menu-icon"></span>
        <span class="mobile-menu-icon"></span>
        <span class="mobile-menu-icon"></span>
      </summary>
      <nav class="mobile-menu-panel" aria-label={nav.ariaLabel}>
        {nav.links.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
    </details>

    <nav class="desktop-nav" aria-label={nav.ariaLabel}>
      {nav.links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="language-switch" href={languageHref} hreflang={languageLabel.toLowerCase()}>
        <span class="language-text">{languageLabel}</span>
        <span class="language-flag" aria-hidden="true">{languageFlag}</span>
      </a>
      <a class="button button-small button-primary header-cta" href={nav.cta.href} aria-label={nav.cta.label}>
        <span class="header-cta-text">{nav.cta.label}</span>
        <span class="header-cta-icon" aria-hidden="true">💬</span>
      </a>
    </div>
  </div>
</header>

<script>
  const mobileMenus = document.querySelectorAll('.mobile-menu');

  for (const menu of mobileMenus) {
    if (!(menu instanceof HTMLDetailsElement)) continue;

    const links = menu.querySelectorAll('.mobile-menu-panel a');
    for (const link of links) {
      link.addEventListener('click', () => {
        menu.open = false;
      });
    }
  }
</script>
