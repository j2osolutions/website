---
import type { Locale, SiteContent } from '../lib/content';

interface Props {
  locale: Locale;
  nav: SiteContent['nav'];
}

const { locale, nav } = Astro.props;
const languageHref = locale === 'es' ? `${import.meta.env.BASE_URL}en/` : import.meta.env.BASE_URL;
const languageLabel = locale === 'es' ? 'EN' : 'ES';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="#top" aria-label="J2O Solutions">
      <img src={`${import.meta.env.BASE_URL}J2O.png`} alt="J2O Solutions" width="96" height="96" />
      <span class="brand-copy">
        <strong>J2O Solutions</strong>
        <span>{nav.tagline}</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label={nav.ariaLabel}>
      {nav.links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="language-switch" href={languageHref} hreflang={languageLabel.toLowerCase()}>
        {languageLabel}
      </a>
      <a class="button button-small button-primary" href={nav.cta.href}>
        {nav.cta.label}
      </a>
    </div>
  </div>
</header>
