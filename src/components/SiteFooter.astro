---
import type { Locale, SiteContent } from '../lib/content';

interface Props {
  locale: Locale;
  footer: SiteContent['footer'];
}

const { locale, footer } = Astro.props;
const homeHref = locale === 'es' ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}en/`;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <a class="footer-brand" href={homeHref}>
        <img src={`${import.meta.env.BASE_URL}J2O.png`} alt="J2O Solutions" width="80" height="80" />
        <div>
          <strong>J2O Solutions</strong>
          <p>{footer.tagline}</p>
        </div>
      </a>
    </div>

    <div class="footer-meta">
      <a href={`mailto:${footer.email}`}>{footer.email}</a>
      <p>{footer.rights}</p>
    </div>
  </div>
</footer>
