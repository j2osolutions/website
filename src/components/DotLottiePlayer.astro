---
interface Props {
  src: string;
  title: string;
  className?: string;
  speed?: number;
}

const { src, title, className = '', speed = 1 } = Astro.props;
---

<div class:list={['dotlottie-shell', className]} aria-hidden="true">
  <dotlottie-player src={src} background="transparent" speed={String(speed)} loop autoplay></dotlottie-player>
  <span class="sr-only">{title}</span>
</div>

<script type="module" src="https://unpkg.com/@dotlottie/player-component@2.7.12/dist/dotlottie-player.mjs"></script>
